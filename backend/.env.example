JWT_SECRET=change-me-to-a-random-long-string
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./speakpal.db
# 大模型（OpenAI 兼容接口）。留空则自动使用 mock 回复
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
ADMIN_KEY=admin123
# 语音合成（可选，OpenAI 兼容的 /audio/speech）。留空则前端用浏览器内置朗读，不需要 key。
# 支持 OpenAI TTS（api.openai.com/v1 + tts-1）、SiliconFlow、Groq 等同一套参数的供应商。
# 用户在「设置」里填的 key 优先；这里只是服务端兜底。
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
