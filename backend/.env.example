JWT_SECRET=change-me-to-a-random-long-string
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./speakpal.db
# 大模型（OpenAI 兼容接口）。服务端不提供模型 key：用户 key 只存浏览器，
# 随 X-LLM-Key 请求头发送。下面两行只是默认地址与模型名。
# 不要加回 LLM_API_KEY，否则「点场景必须自己配 key」这条产品决定会被绕过。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
ADMIN_KEY=admin123
# 语音合成（可选，OpenAI 兼容的 /audio/speech）。留空则前端用浏览器内置朗读，不需要 key。
# 注意：下面的 TTS_BASE_URL / TTS_MODEL / TTS_VOICE 是 **OpenAI 兼容出厂值**，
#      代码不对某一家供应商写死。想用别的家，直接把这三行替换成对应值即可（协议相同）。
# 用户在「设置」里填的 key 优先；这里只是服务端兜底。
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
#
# 硅基流动示例（把上面三行替换成这三行；只取消注释而不删上面三行会重复定义）：
# TTS_BASE_URL=https://api.siliconflow.cn/v1
# TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
#
# 其他同一套参数的供应商（Groq 等）只要支持 POST {base_url}/audio/speech
# 并接受 {"model","input","voice","speed"} 就能用。
