# 复制为 deploy.env 后填写（deploy.env 不进仓库）
# 已解析到本服务器的域名；先用 IP 试跑可填 :80（只有 HTTP）
DOMAIN=speakpal.example.com

# 必填：随机长字符串。容器里写不回 .env，不填的话每次重启都会换，所有人被登出
JWT_SECRET=
ADMIN_KEY=

# 体验额度：评委/新用户没填密钥也能用；按人按天限次，全站每天有总上限
DEMO_LLM_API_KEY=
DEMO_DAILY_PER_USER=80
DEMO_DAILY_TOTAL=3000

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 同源部署不需要跨域；只在前后端分开部署时填前端地址
CORS_ORIGINS=
